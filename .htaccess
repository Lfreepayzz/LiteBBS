Options -Indexes
Options -MultiViews
AcceptPathInfo Off
RewriteEngine On
<FilesMatch "^(?:\..*|config\.php.*|install\.lock|.*\.(?:sql|tmp|md|ps1|sh|ini|bak|old|orig|swp|zip|tar|gz|tgz|rar|7z))$">
 Require all denied
</FilesMatch>
RedirectMatch 404 ^/(?:\.git|\.svn)(?:/|$)
RedirectMatch 404 ^/(?:app|languages|database|cache|logs|uploads|plugins|scripts)/
RedirectMatch 404 ^/market-packages/
RedirectMatch 404 ^/share-packages/
RewriteRule ^admin/?$ index.php [L]
RewriteRule ^install/?$ install.php [L]
RewriteRule ^install\.php$ - [L]
<Files "install.php">
 CGIPassAuth On
</Files>
RewriteRule ^assets/(?:css|js)/[A-Za-z0-9._-]+\.(?:css|js)$ - [L]
RewriteRule ^assets/index\.svg$ - [L]
<IfModule mod_headers.c>
 <FilesMatch "\.(?:css|js|map|png|jpe?g|gif|webp|svg)$">
  Header set Cache-Control "public, max-age=3600"
 </FilesMatch>
</IfModule>
RewriteRule ^templates/[a-z][a-z0-9_-]{1,31}/assets/[A-Za-z0-9][A-Za-z0-9._-]*\.(?:png|jpe?g|gif|webp|svg)$ - [NC,L]
RewriteRule ^templates/ - [R=404,L]
<FilesMatch "^(?!(?:index|install)\.php$).+\.php$">
 Require all denied
</FilesMatch>
RewriteRule ^ index.php [L]
