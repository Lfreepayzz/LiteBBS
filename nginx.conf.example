# Copy this server block into your Nginx site configuration. Update the
# server_name, root, and fastcgi_pass values for the deployment environment.
server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    root /home/code/ww;
    index index.php;
    charset utf-8;

    # Theme images are the only files served directly from templates.
    location ~ ^/templates/[a-z][a-z0-9_-]{1,31}/assets/[A-Za-z0-9][A-Za-z0-9._-]*\.(?:png|jpe?g|gif|webp|svg)$ {
        try_files $uri =404;
        expires 1h;
        add_header Cache-Control "public";
    }

    # Keep theme PHP, manifests, CSS, and JavaScript private. CSS and JS are
    # served by the application's /theme-assets route after manifest checks.
    location ~ ^/templates/ {
        return 404;
    }

    # Application internals and stored uploads must only be accessed through
    # their application routes, such as /avatar and /plugin-assets.
    location ~ ^/(?:app|database|cache|logs|uploads|plugins|scripts|market-packages|share-packages)(?:/|$) {
        return 404;
    }

    location ~ ^/(?:\.git|\.svn)(?:/|$) {
        return 404;
    }

    location ~* /(?:\.|.*\.(?:sql|tmp|md|ps1|sh|ini|bak|old|orig|swp|zip|tar|gz|tgz|rar|7z))$ {
        return 404;
    }

    # The installer remains a direct PHP entry point before installation.
    location = /install.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    # All application routes, including /theme-assets and /plugin-assets,
    # are dispatched through the front controller.
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }

    # Do not execute PHP files other than the two explicit entry points.
    location ~ \.php$ {
        return 404;
    }
}
