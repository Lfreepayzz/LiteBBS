# Place this map in the http context (alongside the server blocks).
map $arg_v $litebbs_asset_cache_control {
    default "public, max-age=3600";
    ~^[a-f0-9]{12}$ "public, max-age=31536000, immutable";
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name forum.example.com;
    return 301 https://forum.example.com$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    server_name forum.example.com;
    # Replace this hostname and certificate paths before deployment.
    ssl_certificate /etc/letsencrypt/live/forum.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forum.example.com/privkey.pem;
    if ($host != forum.example.com) { return 444; }
    root /srv/litebbs;
    index index.php;
    client_max_body_size 12m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; style-src 'self'; script-src 'self'" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location = /index.php {
        include fastcgi_params;
        fastcgi_param HTTPS on;
        fastcgi_param LITEBBS_X_ACCEL_REDIRECT 1;
        # Use the resolved root so PHP-FPM receives a real path when the site
        # root is a symlink (a common control-panel deployment pattern).
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param PATH_INFO "";
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location = /install.php {
        include fastcgi_params;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param SCRIPT_NAME /install.php;
        fastcgi_param PATH_INFO "";
        fastcgi_param SCRIPT_FILENAME $realpath_root/install.php;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location = /install {
        return 307 /install.php$is_args$args;
    }

    location ~ ^/assets/(?:css|js)/[A-Za-z0-9._-]+\.(?:css|js)$ {
        try_files $uri =404;
        add_header Cache-Control $litebbs_asset_cache_control;
    }

    location = /assets/index.svg {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600";
    }

    # PHP authorizes local plugin downloads, then delegates file transfer to
    # Nginx so slow clients do not occupy a PHP-FPM worker.
    location ^~ /__litebbs-uploads/ {
        internal;
        alias /srv/litebbs/uploads/;
        add_header Cache-Control "private, no-store" always;
    }

    # Enable LITEBBS_X_ACCEL_REDIRECT=1 in PHP-FPM to let Nginx serve approved
    # market packages after PHP has completed authorization and cache checks.
    location ^~ /__litebbs-market-packages/ {
        internal;
        alias /srv/litebbs/market-packages/;
    }

    location ~ ^/templates/[a-z][a-z0-9_-]{1,31}/assets/[A-Za-z0-9][A-Za-z0-9._-]*\.(?:css|js|map|png|jpe?g|gif|webp|svg)$ {
        try_files $uri =404;
        add_header Cache-Control $litebbs_asset_cache_control;
    }
    location ~ ^/templates/ { return 404; }

    location ^~ /plugins/ { return 404; }
    location ^~ /app/ { return 404; }
    location ^~ /database/ { return 404; }
    location ^~ /cache/ { return 404; }
    location ^~ /logs/ { return 404; }
    location ^~ /uploads/ { return 404; }
    location ^~ /market-packages/ { return 404; }
    location ~ ^/(?:config\.php.*|.*\.(?:tmp|md|ps1|sh|ini|example|conf|bak|old|orig|swp|zip|tar|gz|tgz|rar|7z)|install\.lock|\.env|\.git) { return 404; }
    location ~ (^|/)private/ { return 404; }
    location ^~ /scripts/ { return 404; }
    location ~ /\. { return 404; }
    location ~ \.php$ { return 404; }

    # Keep the front controller as a fixed existing script. Do not use
    # index.php/$request_uri or $document_root$fastcgi_script_name here: both
    # patterns can make PHP-FPM report "No input file specified".
    location / { try_files /__litebbs_no_static_files__ /index.php?$query_string; }
}
