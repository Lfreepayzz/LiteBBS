{
  "schema": 1,
  "id": "zip-remote-attachments",
  "title": "压缩包与远程附件",
  "description": "支持上传压缩包和远程附件，并提供受控访问。",
  "version": "2.0.0",
  "requires": { "core": ">=1.0 <2.0" },
  "entry": "src/Plugin.php",
  "class": "ZipRemoteAttachmentsPlugin",
  "permissions": ["database", "storage", "routes", "views", "assets"],
  "hooks": {
    "slots": ["topic.create.fields", "post.after-body"],
    "events": ["topic.created", "post.created"]
  },
  "assets": ["assets/style.css"],
  "database_tables": [
    "plg_zip_remote_attachments_files",
    "plg_zip_remote_attachments_grants"
  ]
}
