{
  "schema": 1,
  "id": "markdown",
  "title": "Markdown 渲染",
  "description": "为主题首帖和回复提供安全的 Markdown 排版。",
  "version": "3.0.7",
  "requires": { "core": ">=1.0 <2.0" },
  "entry": "src/Plugin.php",
  "class": "MarkdownPlugin",
  "permissions": ["events", "routes", "views", "assets"],
  "hooks": {
    "slots": ["topic.create.fields", "reply.create.fields", "post.edit.fields"],
    "renderers": ["post.markdown"]
  },
  "public_route_prefix": "markdown",
  "assets": [
    {"path": "assets/editor.css", "pages": ["topic.create", "topic.view", "post.edit"]},
    {"path": "assets/editor.js", "pages": ["topic.create", "topic.view", "post.edit"]}
  ],
  "database_tables": []
}
