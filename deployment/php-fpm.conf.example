; Copy these directives into the active PHP-FPM pool and size them from
; measured worker RSS, not CPU count alone.
[www]
pm = dynamic
pm.max_children = 12
pm.start_servers = 3
pm.min_spare_servers = 2
pm.max_spare_servers = 6
pm.max_requests = 700
request_terminate_timeout = 30s
request_slowlog_timeout = 2s
slowlog = /var/log/php-fpm/litebbs-slow.log
