; Copy the pool settings into the distribution-specific PHP-FPM pool file.
; Size pm.max_children from measured peak worker RSS, not CPU count alone.
[litebbs]
user = www-data
group = www-data
listen = /run/php/php-fpm.sock
listen.owner = www-data
listen.group = www-data
pm = dynamic
pm.max_children = 24
pm.start_servers = 4
pm.min_spare_servers = 4
pm.max_spare_servers = 12
pm.max_requests = 1000
request_terminate_timeout = 60s
catch_workers_output = yes
security.limit_extensions = .php
